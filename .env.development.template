# Plantilla de configuracion de NEXORA para DESARROLLO LOCAL.
# Uso:  cp .env.development.template .env   (y completar los valores vacios / "cambiar-...").
# Para PRODUCCION usa .env.production.template (copiado a .env.production en el servidor).
# `.env` y `.env.production` nunca se versionan. Esta plantilla no debe contener secretos reales.

# --- Entorno ---------------------------------------------------------------
# development | testing | production
NEXORA_ENVIRONMENT=development

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=nexora
POSTGRES_PASSWORD=cambiar-esta-clave-local
POSTGRES_DB=nexora_db
POSTGRES_TEST_DB=nexora_db_test
# Puertos publicados en el host (5432 suele estar ocupado por otras bases locales).
POSTGRES_HOST_PORT=45336
POSTGRES_TEST_HOST_PORT=45337

# Conexion usada al ejecutar el backend fuera de Docker (uv run python main.py).
# Dentro de Docker, el compose arma la URL apuntando al servicio "postgres".
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:cambiar-esta-clave-local@localhost:45336/nexora_db
NEXORA_TEST_DATABASE_URL=postgresql+psycopg://nexora:cambiar-esta-clave-local@localhost:45337/nexora_db_test
NEXORA_DATABASE_ECHO=false

# --- API -------------------------------------------------------------------
API_HOST_PORT=45335
API_WORKERS=1
RESTART_POLICY=unless-stopped
NEXORA_IMAGE_TAG=local

# --- JWT -------------------------------------------------------------------
# Obligatorio. Generar con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# En produccion debe tener 32+ caracteres y no puede ser el secreto de desarrollo.
NEXORA_JWT_SECRET=
NEXORA_JWT_ALGORITHM=HS256
NEXORA_JWT_ISSUER=nexora
NEXORA_JWT_AUDIENCE=nexora-app
NEXORA_ACCESS_TOKEN_TTL_MINUTES=10
NEXORA_REFRESH_TOKEN_TTL_DAYS=7

# Inactividad deslizante: 1-1440 minutos; no debe superar el limite absoluto, debe ser
# mayor que NEXORA_ACCESS_TOKEN_TTL_MINUTES y al menos el doble del umbral de actividad.
NEXORA_SESSION_IDLE_TIMEOUT_MINUTES=30

# Duracion absoluta desde login: 1-168 horas; refresh nunca la extiende.
NEXORA_SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Gracia del JTI inmediatamente anterior para concurrencia/reintentos: 1-300 segundos.
NEXORA_REFRESH_ROTATION_GRACE_SECONDS=30

# Umbral entre escrituras de actividad por request: 1-300 segundos.
NEXORA_SESSION_ACTIVITY_TOUCH_SECONDS=60

# Aviso previo al cierre por inactividad: 10-600 segundos, estrictamente menor que la inactividad.
# El frontend muestra «Tu sesión está por expirar» este tiempo antes de cerrarla.
NEXORA_SESSION_WARNING_SECONDS=120

# --- CORS y cookies --------------------------------------------------------
# Lista JSON de origenes permitidos; tambien valida el Origin de las peticiones con cookie.
# OBLIGATORIO incluir el origen EXACTO desde el que abres el frontend (esquema + host + puerto):
#   - desarrollo (Vite):          http://localhost:5173
#   - Docker (Nginx, produccion): http://localhost:45334  (o el FRONTEND_HOST_PORT que uses)
# `localhost` y `127.0.0.1` son origenes distintos. Si falta el tuyo, /auth/refresh responde 401 al
# vencer el access token (cada NEXORA_ACCESS_TOKEN_TTL_MINUTES) y la app cierra la sesion.
NEXORA_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:45334","http://127.0.0.1:5173","http://127.0.0.1:45334"]
# lax | strict | none
NEXORA_COOKIE_SAMESITE=lax
# Vacio salvo que el front viva en otro subdominio.
NEXORA_COOKIE_DOMAIN=
NEXORA_CSRF_COOKIE_PATH=/

# --- Administrador inicial --------------------------------------------------
# La siembra de arranque crea este usuario con rol ADMINISTRADOR solo si no existe ningun
# administrador activo. Sin valores por defecto; en produccion son obligatorios.
# Contrasena inicial: 6-24 code points Unicode, sin recortar espacios.
# Requiere mayuscula (Lu), minuscula (Ll), numero (Nd) y especial (P* o S*; @ # $ % & !).
# Argon2id sin cambios; politica compartida con creacion y cambio de contrasenas.
NEXORA_BOOTSTRAP_ADMIN_USERNAME=
NEXORA_BOOTSTRAP_ADMIN_EMAIL=
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=
NEXORA_BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
NEXORA_BOOTSTRAP_ADMIN_LAST_NAME=NEXORA

# --- Frontend --------------------------------------------------------------
# Puerto publicado del frontend de produccion (Nginx) y del de desarrollo (Vite, profile dev).
# Si cambias FRONTEND_HOST_PORT, agrega ese origen a NEXORA_ALLOWED_ORIGINS.
FRONTEND_HOST_PORT=45334
FRONTEND_DEV_HOST_PORT=5173
# Solo VITE_*: se incorporan al bundle y son publicas. Nunca pongas secretos aqui.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Nexora

# --- Fuerza bruta ----------------------------------------------------------
NEXORA_LOGIN_MAX_ATTEMPTS=5
NEXORA_LOGIN_ATTEMPT_WINDOW_SECONDS=300
NEXORA_LOGIN_BLOCK_SECONDS=900

# --- Conexión SQL Server ----------------------------------------------------
NEXORA_MSSQL_HOST=
NEXORA_MSSQL_PORT=1433
NEXORA_MSSQL_DATABASE=
NEXORA_MSSQL_USER=
NEXORA_MSSQL_PASSWORD=
NEXORA_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
NEXORA_MSSQL_TRUST_SERVER_CERTIFICATE=false
NEXORA_MSSQL_CONNECT_TIMEOUT_SECONDS=10
NEXORA_MSSQL_QUERY_TIMEOUT_SECONDS=120