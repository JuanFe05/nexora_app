# Plantilla de configuracion de NEXORA para PRODUCCION.
# Uso en el servidor:
#   cp .env.production.template .env.production     (completar TODOS los valores marcados CAMBIAR)
#   docker compose --env-file .env.production up -d --build
# `.env.production` nunca se versiona ni se copia a la imagen. No guardes secretos reales en esta plantilla.
# Diferencias con desarrollo (.env.development.template): entorno production, sin base de pruebas,
# puertos solo en localhost (detras de un proxy HTTPS), origen publico con https, imagen versionada.

# --- Entorno ---------------------------------------------------------------
# Con production: cookies `Secure` (exigen HTTPS) y la API rechaza el secreto JWT de desarrollo
# o uno de menos de 32 caracteres.
NEXORA_ENVIRONMENT=production

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=nexora
# CAMBIAR: contrasena larga y aleatoria (32+ caracteres), distinta de la de desarrollo.
POSTGRES_PASSWORD=
POSTGRES_DB=nexora
# La base solo se publica en localhost (o quita este puerto del compose). Nunca 0.0.0.0 en produccion.
POSTGRES_HOST_PORT=127.0.0.1:45336
# Dentro de Docker el compose arma NEXORA_DATABASE_URL con el servicio "postgres": no se define aqui.
# La base de pruebas (POSTGRES_TEST_*, NEXORA_TEST_DATABASE_URL) NO existe en produccion.

# --- API -------------------------------------------------------------------
# Solo en localhost: el acceso publico pasa por el proxy HTTPS hacia el frontend (Nginx).
API_HOST_PORT=127.0.0.1:45335
API_WORKERS=1
RESTART_POLICY=unless-stopped
# CAMBIAR: etiqueta de version (p. ej. 1.0.0) para poder volver a una imagen anterior.
NEXORA_IMAGE_TAG=1.0.0

# --- JWT -------------------------------------------------------------------
# CAMBIAR: secreto aleatorio de 32+ caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si lo rotas se invalidan las sesiones existentes.
NEXORA_JWT_SECRET=
NEXORA_JWT_ALGORITHM=HS256
NEXORA_JWT_ISSUER=nexora
NEXORA_JWT_AUDIENCE=nexora-app
NEXORA_ACCESS_TOKEN_TTL_MINUTES=10
NEXORA_REFRESH_TOKEN_TTL_DAYS=7
# Politica de sesion: inactividad deslizante, tope absoluto, gracia de rotacion, umbral de actividad y
# aviso previo (ver .env.development.template para los limites y su relacion).
NEXORA_SESSION_IDLE_TIMEOUT_MINUTES=30
NEXORA_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
NEXORA_REFRESH_ROTATION_GRACE_SECONDS=30
NEXORA_SESSION_ACTIVITY_TOUCH_SECONDS=60
NEXORA_SESSION_WARNING_SECONDS=120

# --- CORS y cookies --------------------------------------------------------
# CAMBIAR: SOLO el origen publico exacto con https (esquema + host + puerto si no es 443).
# Sin localhost ni 127.0.0.1. Si falta el origen real, /auth/refresh responde 401 al vencer el access
# token y la app cierra la sesion.
NEXORA_ALLOWED_ORIGINS=["https://nexora.example.com"]
# Con un solo dominio: lax y sin dominio. Cambialo solo si el front y la API viven en dominios distintos.
NEXORA_COOKIE_SAMESITE=lax
NEXORA_COOKIE_DOMAIN=
NEXORA_CSRF_COOKIE_PATH=/

# --- Administrador inicial --------------------------------------------------
# Se usa solo para crear al primer administrador si no existe ninguno activo (en produccion la API
# exige que exista uno). Contrasena: 6-24 caracteres con mayuscula, minuscula, numero y especial.
# TRAS EL PRIMER ARRANQUE EXITOSO: borra NEXORA_BOOTSTRAP_ADMIN_PASSWORD de este archivo.
NEXORA_BOOTSTRAP_ADMIN_USERNAME=
NEXORA_BOOTSTRAP_ADMIN_EMAIL=
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=
NEXORA_BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
NEXORA_BOOTSTRAP_ADMIN_LAST_NAME=NEXORA

# --- Frontend --------------------------------------------------------------
# El proxy HTTPS del servidor apunta a este puerto (localhost). El frontend de desarrollo (Vite) no se
# despliega.
FRONTEND_HOST_PORT=127.0.0.1:45334
# Solo VITE_*: se incorporan al bundle y son publicas. Nunca pongas secretos aqui.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=NEXORA

# --- Fuerza bruta ----------------------------------------------------------
NEXORA_LOGIN_MAX_ATTEMPTS=5
NEXORA_LOGIN_ATTEMPT_WINDOW_SECONDS=300
NEXORA_LOGIN_BLOCK_SECONDS=900
